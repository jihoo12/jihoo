// Fusing a pipeline with a macro: `map`, `filter` and a sum over a list as
// one loop, with no list in between. Written with `lists`, the same pipeline
// builds two lists of a million elements on the way; fused, it runs about
// three times as fast natively, as fast as the loop written out by hand.
//   jihoo run examples/pipe.jh
//
// The macro runs on the VM while compiling: it reads the stages from `plan`
// and puts their code together into the body of one `for` loop, with the
// help of `stage`, a function on code that runs while compiling too. The
// stages' functions come after the plan, as many as there are (`funcs`).
//
// This is an experiment, and its awkward parts show what macros lack today:
// - `plan` is a string, since a macro cannot look inside the code it is given
//   to see `map(f)`;
// - the result goes into a variable named by the caller (`"s"`), since a
//   macro that makes statements cannot be used as an expression;
// - the sum is an `i64`, since a macro does not know the types of its code.
// The aim is `let s = xs |> map(f) |> filter(g) |> sum()`, with the fusion
// written as a library; see the design in `docs/internals/code-as-data.md`.
import lists
import strings

// The code of one stage, after the stages before it in `body`. `v` is the
// value so far, the same `v` in every piece of code one expansion builds.
fn stage(kind: str, call: expr, body: stmts) -> stmts {
    if kind == "map" {
        return quote {
            $body
            let v = $call
        }
    }
    return quote {
        $body
        if !$call { continue }
    }
}

// The functions go into variables before the loop, so that a closure is made
// once, not once per element. The names come from `unique`, as code from a
// hole declares names in the caller's scope.
macro pipe(out: str, xs: expr, plan: str, funcs: [expr]) -> stmts {
    let binds = quote { let acc = 0 }
    let body = quote { let v = x }
    let n = 0
    for kind in strings.split(plan, " ") {
        if kind == "map" || kind == "filter" {
            let g = unique("stage")
            binds = quote {
                $binds
                let $g = $(funcs[n])
            }
            body = stage(kind, quote($(ident(g))(v)), body)
            n += 1
        }
    }
    // `sum` is the only way to end a pipeline so far.
    return quote {
        $binds
        for x in $xs {
            $body
            acc += v
        }
        let $out = acc
    }
}

fn main() {
    let xs: [i64] = []
    for i in 0..1000 {
        push(xs, i % 100)
    }
    let k = 7

    // With `lists`: a list for `map`, another for `filter`.
    let ys = lists.map(i64, i64, xs, fn(x: i64) -> i64 { return x * 3 + k })
    let zs = lists.filter(i64, ys, fn(x: i64) -> bool { return x % 2 == 0 })
    print(lists.fold(i64, i64, zs, 0, fn(a: i64, x: i64) -> i64 { return a + x }))

    // Fused: one loop, no list in between. Prints the same.
    pipe!("s", xs, "map filter sum",
        fn(x: i64) -> i64 { return x * 3 + k },
        fn(x: i64) -> bool { return x % 2 == 0 })
    print(s)
}

// A program without a profile attribute is native: `jihoo run` compiles it with
// LLVM and runs it. With `#![hosted]` at the top it would run on the VM instead.
//   jihoo run examples/hello.jh

fn greet(name: str) -> str {
    return "Hello, " + name + "!"
}

fn main() {
    print(greet("jihoo"))

    let i = 1
    while i <= 5 {
        print(i * i)
        i = i + 1
    }
}

// The prelude: types every program can use without an import, in every
// profile. A module's own item of the same name comes first.
//
//   fn find(xs: [i64; 3], x: i64) -> Option(i64) {
//       ...
//       return Option.Some(i)
//   }
//   match parse("42") {
//       Ok(n) => print(n)
//       Err(msg) => print(msg)
//   }
//
// The compiler carries this file in itself, so it is always the one it was
// built with. Its impls are not checked with every program, as other
// modules' are (some are for types a profile lacks, such as `str`), but by
// the compiler's tests.

// A value that may be missing.
pub enum Option(T: type) {
    Some(T)
    None
}

// The value of something that worked, or why it did not.
pub enum Result(T: type, E: type) {
    Ok(T)
    Err(E)
}

// An order on a type's values. `lists.sort` sorts by it.
pub trait Ord {
    // Less than zero, zero or more than zero, as `a` comes before, with or
    // after `b`.
    fn compare(a: Self, b: Self) -> i64

    // Whether `a` comes before `b`.
    fn less(a: Self, b: Self) -> bool {
        return Self.compare(a, b) < 0
    }
}

impl Ord for i8 {
    fn compare(a: i8, b: i8) -> i64 {
        if a < b {
            return -1
        }
        if a > b {
            return 1
        }
        return 0
    }
}

impl Ord for i16 {
    fn compare(a: i16, b: i16) -> i64 {
        if a < b {
            return -1
        }
        if a > b {
            return 1
        }
        return 0
    }
}

impl Ord for i32 {

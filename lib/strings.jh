// Text functions for hosted and native programs. A `str` is a sequence of
// bytes, usually UTF-8; these functions work on bytes, and treat only ASCII
// specially (case, spaces, digits), so they never split a multi-byte
// character they did not find themselves.
//
//   import strings
//   let parts = strings.split("a,b,c", ",")      // ["a", "b", "c"]
//   print(strings.join(parts, " + "))            // a + b + c
//   match strings.parse_int(" 42 ") {
//       Some(n) => print(n + 1)                  // 43
//       None => print("not a number")
//   }

// ---- searching ----

// Where `sub` first occurs in `s` at or after byte `from`, or -1.
pub fn index_from(s: str, sub: str, from: i64) -> i64 {
    let n = len(sub)
    for i in from..len(s) - n + 1 {
        if s[i:i + n] == sub {
            return i
        }
    }
    return -1
}

// Where `sub` first occurs in `s`, or -1.
pub fn index_of(s: str, sub: str) -> i64 {
    return index_from(s, sub, 0)
}

// Where `sub` last occurs in `s`, or -1.
pub fn last_index_of(s: str, sub: str) -> i64 {
    let i = len(s) - len(sub)
    while i >= 0 {
        if s[i:i + len(sub)] == sub {
            return i
        }
        i -= 1
    }
    return -1
}

pub fn contains(s: str, sub: str) -> bool {
    return index_of(s, sub) >= 0
}

pub fn starts_with(s: str, prefix: str) -> bool {
    return len(prefix) <= len(s) && s[:len(prefix)] == prefix
}

pub fn ends_with(s: str, suffix: str) -> bool {
    return len(suffix) <= len(s) && s[len(s) - len(suffix):] == suffix
}

// How many times `sub` occurs in `s`, not overlapping. `sub` must not be empty.
pub fn count(s: str, sub: str) -> i64 {
    let n = 0
    let i = index_of(s, sub)
    while i >= 0 {
        n += 1
        i = index_from(s, sub, i + len(sub))
    }
    return n
}

// ---- splitting and joining ----

// The parts of `s` between occurrences of `sep`, which must not be empty:
// `split("a,,b", ",")` is `["a", "", "b"]`, and `split("", ",")` is `[""]`.
pub fn split(s: str, sep: str) -> [str] {
    let parts: [str] = []
    let start = 0
    let i = index_of(s, sep)
    while i >= 0 {
        push(parts, s[start:i])
        start = i + len(sep)
        i = index_from(s, sep, start)
    }
    push(parts, s[start:])
    return parts
}

// The words of `s`: the runs of bytes that are not ASCII spaces.
pub fn fields(s: str) -> [str] {
    let words: [str] = []
    let i = 0
    while i < len(s) {
        while i < len(s) && is_space(s[i]) {
            i += 1
        }
        let start = i
        while i < len(s) && !is_space(s[i]) {
            i += 1
        }
        if i > start {
            push(words, s[start:i])
        }
    }
    return words
}

// The lines of `s`, without their line endings (`\n` or `\r\n`). A final
// line ending does not start another line.
pub fn lines(s: str) -> [str] {
    let out: [str] = []
    let start = 0
    for i, b in s {
        if b == 10 {
            push(out, trim_cr(s[start:i]))
            start = i + 1
        }
    }
    if start < len(s) {
        push(out, trim_cr(s[start:]))
    }
    return out
}

fn trim_cr(line: str) -> str {
    if ends_with(line, "\r") {
        return line[:len(line) - 1]
    }
    return line
}

// `parts` with `sep` between each two.
pub fn join(parts: [str], sep: str) -> str {
    // Pushed byte by byte: `out` is changed in place, so this takes time in
    // proportion to the result, where adding up the parts with `+` would copy
    // the text so far for each one.
    let out: [u8] = []
    for i, part in parts {
        if i > 0 {
            for b in sep {
                push(out, b)
            }
        }
        for b in part {
            push(out, b)
        }
    }
    return from_bytes(out)
}

// `s` written `n` times.
pub fn repeat(s: str, n: i64) -> str {
    let out: [u8] = []
    for i in 0..n {
        for b in s {
            push(out, b)
        }
    }
    return from_bytes(out)
}

// `s` with every occurrence of `old`, which must not be empty, replaced by `new`.
pub fn replace(s: str, old: str, new: str) -> str {
    return join(split(s, old), new)
}

// ---- trimming ----

// `s` without ASCII spaces at either end.
pub fn trim(s: str) -> str {
    return trim_end(trim_start(s))
}

pub fn trim_start(s: str) -> str {
    let i = 0
    while i < len(s) && is_space(s[i]) {
        i += 1
    }
    return s[i:]
}

pub fn trim_end(s: str) -> str {
    let n = len(s)
    while n > 0 && is_space(s[n - 1]) {
        n -= 1
    }
    return s[:n]
}

// ---- bytes and case ----

// The bytes of `s`.
pub fn bytes(s: str) -> [u8] {
    let out: [u8] = []
    for b in s {
        push(out, b)
    }
    return out
}

// The one-byte string of byte `b`.
pub fn from_byte(b: u8) -> str {
    return from_bytes([b])
}

// `s` with ASCII letters made upper case.
pub fn to_upper(s: str) -> str {
    let out = bytes(s)
    for i in 0..len(out) {
        if out[i] >= 97 && out[i] <= 122 {
            out[i] -= 32
        }
    }
    return from_bytes(out)
}

// `s` with ASCII letters made lower case.
pub fn to_lower(s: str) -> str {
    let out = bytes(s)
    for i in 0..len(out) {
        if out[i] >= 65 && out[i] <= 90 {
            out[i] += 32
        }
    }
    return from_bytes(out)
}

// Space, tab, newline, vertical tab, form feed or carriage return.
pub fn is_space(b: u8) -> bool {
    return b == 32 || (b >= 9 && b <= 13)
}

pub fn is_digit(b: u8) -> bool {
    return b >= 48 && b <= 57
}

pub fn is_letter(b: u8) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

// ---- numbers ----

// The integer `s` writes in decimal, with an optional sign and spaces around
// it, or `None` if it is not one or does not fit an `i64`.
pub fn parse_int(s: str) -> Option(i64) {
    let t = trim(s)
    let i = 0
    let neg = false
    if len(t) > 0 && (t[0] == 45 || t[0] == 43) {   // '-' or '+'
        neg = t[0] == 45
        i = 1
    }
    if i == len(t) {
        return Option.None
    }
    // Counted negative, so that the most negative i64 fits.
    let n = 0
    for k in i..len(t) {
        if !is_digit(t[k]) {
            return Option.None
        }
        let d = (t[k] - 48) as i64
        if n < (-9223372036854775807 - 1 + d) / 10 {
            return Option.None
        }
        n = n * 10 - d
    }
    if neg {
        return Option.Some(n)
    }
    if n == -9223372036854775807 - 1 {
        return Option.None
    }
    return Option.Some(-n)
}

// The number `s` writes in decimal, `[+-]digits[.digits][(e|E)[+-]digits]`
// with spaces around it, as the nearest `f64` (ties to even), or `None` if it
// is not one. Too large a number is infinite and too small a one zero, with
// its sign: `parse_float("1e999")` is `Some(inf)`.
pub fn parse_float(s: str) -> Option(f64) {
    let x = parse_f64(trim(s))
    // Not a number is the only NaN `parse_f64` gives.
    if x != x {
        return Option.None
    }
    return Option.Some(x)
}

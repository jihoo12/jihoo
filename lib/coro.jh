#![freestanding]
// Stackful coroutines for freestanding programs (x86_64 Linux). A coroutine
// runs a function on a stack of its own; `yield` hands a value back to whoever
// resumed it and waits, `resume` continues it until its next `yield`.
//
//   import coro
//   fn squares(c: *coro.Coro) {
//       let i = 1
//       while i <= 3 {
//           coro.yield(c, i * i)
//           i = i + 1
//       }
//   }
//   let c = coro.new(squares, 64 * 1024)
//   while coro.resume(&c) {
//       use(c.value)              // 1, 4, 9
//   }
//   coro.free(&c)
//
// A started coroutine must stay where it is: its body holds a pointer to it.
// Switching contexts is a few lines of inline asm (`switch` and `start` below).

pub struct Coro {
    // The value of the last `yield`; also how the resumer can pass a value in.
    value: i64
    // For the body to use as it likes, such as a pointer to more state.
    data: *u8
    body: fn(*Coro)
    stack: *u8
    size: i64
    // Saved stack pointers: the coroutine's while it waits, the resumer's
    // while the coroutine runs.
    sp: *u8
    caller: *u8
    started: bool
    done: bool
}

// A coroutine that will run `body` on a stack of `size` bytes. It starts on the
// first `resume`. If no stack can be had, it is done from the start.
pub fn new(body: fn(*Coro), size: i64) -> Coro {
    let p = syscall(9, 0, size, 0x3, 0x22, 0 - 1, 0)    // mmap: read/write, private, anonymous
    let none = 0 as *u8
    let c = Coro { value: 0, data: none, body: body, stack: none, size: 0, sp: none, caller: none, started: false, done: true }
    if p >= 0 {
        c.stack = p as *u8
        c.size = size
        c.done = false
    }
    return c
}

// Runs `c` until it yields (true: `c.value` is what it yielded) or its body
// returns (false). Resuming a finished coroutine does nothing.
pub fn resume(c: *Coro) -> bool {
    if c.done {
        return false
    }
    if c.started {
        switch(&c.caller, c.sp)
    } else {
        c.started = true
        let top = (c.stack as i64 + c.size) & !15         // 16-byte aligned, as calls need
        start(&c.caller, top as *u8, c, run)
    }
    return !c.done
}

// Called by the body: hands `v` to the resumer, and returns when resumed.
pub fn yield(c: *Coro, v: i64) {
    c.value = v
    switch(&c.sp, c.caller)
}

// Frees the stack. The coroutine must not be resumed afterwards.
pub fn free(c: *Coro) {
    if c.size > 0 {
        syscall(11, c.stack, c.size)                       // munmap
    }
    c.size = 0
    c.done = true
}

// The bottom of every coroutine's stack: runs the body, then leaves for good.
fn run(c: *Coro) {
    let body = c.body
    body(c)
    c.done = true
    switch(&c.sp, c.caller)
}

// Saves the running context and continues the one whose saved stack pointer is
// `to`; returns when something switches back to the saved one.
//
// The context is saved on its own stack, below the red zone (128 bytes that leaf
// functions may use without moving `rsp`): the address to continue at (label
// `1`), then the registers calls preserve, and the input registers, which the
// other side would otherwise leave changed. Its stack pointer goes to `*save`.
// The other side is restored in the opposite order, and `ret` continues at its
// label. `start` saves the same way.
fn switch(save: **u8, to: *u8) {
    asm("sub rsp, 128",
        "lea rax, [rip + 1f]",
        "push rax",
        "push rbp", "push rbx", "push r12", "push r13", "push r14", "push r15",
        "push rdi", "push rsi", "push rdx", "push rcx",
        "mov [{0}], rsp",
        "mov rsp, {1}",
        "pop rcx", "pop rdx", "pop rsi", "pop rdi",
        "pop r15", "pop r14", "pop r13", "pop r12", "pop rbx", "pop rbp",
        "ret",
        "1:",
        "add rsp, 128",
        in("rdi") save, in("rsi") to,
        clobber("rax", "r8", "r9", "r10", "r11",
                "xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7",
                "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15", "memory"))
}

// Saves the running context like `switch`, then calls `entry(c)` on the fresh
// stack whose top is `top`. `entry` never returns: it switches back instead.
fn start(save: **u8, top: *u8, c: *Coro, entry: fn(*Coro)) {
    asm("sub rsp, 128",
        "lea rax, [rip + 1f]",
        "push rax",
        "push rbp", "push rbx", "push r12", "push r13", "push r14", "push r15",
        "push rdi", "push rsi", "push rdx", "push rcx",
        "mov [{0}], rsp",
        "mov rsp, {1}",
        "mov rdi, {2}",
        "call {3}",
        "ud2",
        "1:",
        "add rsp, 128",
        in("rdi") save, in("rsi") top, in("rdx") c, in("rcx") entry,
        clobber("rax", "r8", "r9", "r10", "r11",
                "xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7",
                "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15", "memory"))
}

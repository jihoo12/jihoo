#![native]
// Stackful coroutines for native programs (x86_64 and aarch64 Linux). A
// coroutine runs a function on a stack of its own; `yield` hands a value back
// to whoever resumed it and waits, `resume` continues it until its next `yield`.
//
//   import coro
//   fn squares(c: *coro.Coro) {
//       let i = 1
//       while i <= 3 {
//           coro.yield(c, i * i)
//           i = i + 1
//       }
//   }
//   let c = coro.new(squares, 64 * 1024)
//   while coro.resume(&c) {
//       use(c.value)              // 1, 4, 9
//   }
//   coro.free(&c)
//
// A started coroutine must stay where it is: its body holds a pointer to it.
// The C library switches contexts (`makecontext` and `swapcontext`), so this
// works on every target the C library supports, with no assembly here.

import libc

// The C library's contexts. A context is a C `ucontext_t`, which this module
// handles as bytes, apart from the fields at its start (`ContextHead`).
// `makecontext` passes the `int`s after `argc` to `func`; here always two.
extern fn getcontext(ucp: *u8) -> i32
extern fn makecontext(ucp: *u8, func: fn(i32, i32), argc: i32, ...)
extern fn swapcontext(save: *u8, to: *u8) -> i32

// Room for a `ucontext_t`, which glibc makes 968 bytes on x86_64 and 4560 on
// aarch64.
const CONTEXT_SIZE = 8192

// The start of a `ucontext_t`, the same on x86_64 and aarch64: what has to be
// set before `makecontext`.
struct ContextHead {
    flags: u64
    link: *u8           // the context that goes on when the function returns
    stack: *u8          // the stack to run on (`uc_stack`)
    stack_flags: i32
    stack_size: u64
}

pub struct Coro {
    // The value of the last `yield`; also how the resumer can pass a value in.
    value: i64
    // For the body to use as it likes, such as a pointer to more state.
    data: *u8
    body: fn(*Coro)
    stack: *u8
    size: i64
    // Saved contexts: the coroutine's while it waits, the resumer's while the
    // coroutine runs. One allocation holds both.
    context: *u8
    caller: *u8
    started: bool
    done: bool
}

// A coroutine that will run `body` on a stack of `size` bytes. It starts on the
// first `resume`. If no memory can be had, it is done from the start.
pub fn new(body: fn(*Coro), size: i64) -> Coro {
    let none = 0 as *u8
    let c = Coro { value: 0, data: none, body: body, stack: none, size: 0, context: none, caller: none, started: false, done: true }
    let stack = libc.malloc(size as u64)
    let contexts = libc.malloc((2 * CONTEXT_SIZE) as u64)
    if stack == none || contexts == none {
        libc.free(stack)
        libc.free(contexts)
        return c
    }
    c.stack = stack
    c.size = size
    c.context = contexts
    c.caller = contexts + CONTEXT_SIZE
    c.done = false
    return c
}

// Runs `c` until it yields (true: `c.value` is what it yielded) or its body
// returns (false). Resuming a finished coroutine does nothing.
pub fn resume(c: *Coro) -> bool {
    if c.done {
        return false
    }
    if !c.started {
        c.started = true
        getcontext(c.context)
        let head = c.context as *ContextHead
        head.link = c.caller
        head.stack = c.stack
        head.stack_size = c.size as u64
        // `makecontext` passes `int`s, so the pointer goes in two halves.
        let p = c as u64
        makecontext(c.context, run, 2, p as i32, (p >> 32) as i32)
    }
    swapcontext(c.caller, c.context)
    return !c.done
}

// Called by the body: hands `v` to the resumer, and returns when resumed.
pub fn yield(c: *Coro, v: i64) {
    c.value = v
    swapcontext(c.context, c.caller)
}

// Frees the stack and the contexts. The coroutine must not be resumed afterwards.
pub fn free(c: *Coro) {
    if c.size > 0 {
        libc.free(c.stack)
        libc.free(c.context)
    }
    c.size = 0
    c.done = true
}

// The bottom of every coroutine's stack: runs the body. When it returns, the
// context's `link`, the last resumer, goes on.
fn run(low: i32, high: i32) {
    let c = ((high as u32 as u64) << 32 | low as u32 as u64) as *Coro
    let body = c.body
    body(c)
    c.done = true
}

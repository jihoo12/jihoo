// Functions on lists (`[T]`) for hosted and native programs. Each returns a
// new list: lists are values, so the one passed in is never changed. The
// element types are inferred from the arguments, or can be written first.
//
//   import lists
//   let xs: [i64] = [3, 1, 2]
//   let sorted = lists.sort(xs)                 // by `Ord`; `sort_by` takes an order
//   let doubled = lists.map(sorted, fn(x) -> i64 { return x * 2 })
//   print(lists.index_of(doubled, 4))           // 1
//
// `fuse!` runs a pipeline of `map` and `filter` stages as one loop, building
// no list between them:
//
//   let total = lists.fuse!(xs, map(fn(x: i64) -> i64 { return x * x }),
//                               filter(fn(x: i64) -> bool { return x > 2 }),
//                               sum())
import meta

// Where `x` first is in `xs`, or -1.
pub fn index_of(comptime T: type, xs: [T], x: T) -> i64 {
    for i, y in xs {
        if y == x {
            return i
        }
    }
    return -1
}

pub fn contains(comptime T: type, xs: [T], x: T) -> bool {
    return index_of(T, xs, x) >= 0
}

// `xs` back to front.
pub fn reverse(comptime T: type, xs: [T]) -> [T] {
    let out: [T] = []
    for i in 0..len(xs) {
        push(out, xs[len(xs) - 1 - i])
    }
    return out
}

// `f` of each element, in order.
pub fn map(comptime T: type, comptime U: type, xs: [T], f: fn(T) -> U) -> [U] {
    let out: [U] = []
    for x in xs {
        push(out, f(x))
    }
    return out
}

// The elements for which `keep` is true, in order.
pub fn filter(comptime T: type, xs: [T], keep: fn(T) -> bool) -> [T] {
    let out: [T] = []
    for x in xs {
        if keep(x) {
            push(out, x)
        }
    }
    return out
}

// `f(... f(f(init, xs[0]), xs[1]) ..., xs[n - 1])`.
pub fn fold(comptime T: type, comptime A: type, xs: [T], init: A, f: fn(A, T) -> A) -> A {
    let acc = init
    for x in xs {
        acc = f(acc, x)
    }
    return acc
}

// `xs` in the order of its elements' `Ord`, least first; stable, as `sort_by`.
pub fn sort(comptime T: Ord, xs: [T]) -> [T] {
    return sort_by(xs, fn(a: T, b: T) -> bool { return a.less(b) })
}

// The least element of `xs` by its `Ord`, the first of equal ones; `None` if
// `xs` is empty.
pub fn min(comptime T: Ord, xs: [T]) -> Option(T) {
    if len(xs) == 0 {
        return Option.None
    }
    let best = xs[0]
    for x in xs {
        if x.less(best) {
            best = x
        }
    }
    return Option.Some(best)
}

// The greatest element of `xs` by its `Ord`, the first of equal ones; `None`
// if `xs` is empty.
pub fn max(comptime T: Ord, xs: [T]) -> Option(T) {
    if len(xs) == 0 {
        return Option.None
    }
    let best = xs[0]
    for x in xs {
        if best.less(x) {
            best = x
        }
    }
    return Option.Some(best)
}

// `xs` sorted so that `less(b, a)` is false for every `a` before `b`. The
// sort is stable (equal elements keep their order) and takes O(n log n) calls
// of `less`.
pub fn sort_by(comptime T: type, xs: [T], less: fn(T, T) -> bool) -> [T] {
    // Bottom-up merge sort: merge runs of width 1, 2, 4, ... from `src` into `dst`.
    // `len` first: `xs` is then not used after it moves into `src`, so a list
    // handed over is sorted without a copy.
    let n = len(xs)
    let src = xs
    let width = 1
    while width < n {
        let dst: [T] = []
        let lo = 0
        while lo < n {
            let mid = smaller(lo + width, n)
            let hi = smaller(lo + 2 * width, n)
            let i = lo
            let j = mid
            while i < mid || j < hi {
                // Take from the right run only when it is strictly less: stable.
                if i < mid && (j >= hi || !less(src[j], src[i])) {
                    push(dst, src[i])
                    i += 1
                } else {
                    push(dst, src[j])
                    j += 1
                }
            }
            lo = hi
        }
        src = dst
        width *= 2
    }
    return src
}

// The integers from `lo` up to but not including `hi`.
pub fn range(lo: i64, hi: i64) -> [i64] {
    let out: [i64] = []
    for i in lo..hi {
        push(out, i)
    }
    return out
}

fn smaller(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

// ---- fused pipelines ----

// `fuse!(xs, stage...)`: the stages run on each element of `xs` in turn, in
// one loop, with no list between them; it is as fast as the loop written out.
// The stages are `map(f)`, which replaces the value with `f(value)`, and
// `filter(keep)`, which drops it unless `keep(value)`. The last may end the
// pipeline and give its result:
//
// - `sum()`, the default: the sum of what is left, of the type the stages
//   end with (any number type);
// - `count()`: how many values are left, an `i64`;
// - `collect()`: a list of what is left.
//
// The functions are evaluated once, before the loop. `fuse!` reads its stages
// with `meta.node` and asks `type_of` for the type the last stage gives.
pub macro fuse(xs: expr, stages: [expr]) -> expr {
    let binds = quote {}
    let body = quote { let v = x }
    // An expression of the type each stage gives, only typed, never run.
    let sample = quote($xs[0])
    let end = "sum"
    for i, s in stages {
        match meta.node(s) {
            Call(kind, args) => {
                if (kind == "map" || kind == "filter") && len(args) == 1 {
                    let g = unique("stage")
                    binds = quote {
                        $binds
                        let $g = $(args[0])
                    }
                    body = fuse_stage(kind, quote($(ident(g))(v)), body)
                    if kind == "map" {
                        sample = quote(($(args[0]))($sample))
                    }
                } else if (kind == "sum" || kind == "count" || kind == "collect") && len(args) == 0 && i == len(stages) - 1 {
                    end = kind
                } else {
                    not_a_stage(s)
                }
            }
            _ => not_a_stage(s)
        }
    }
    if end == "count" {
        return quote({
            $binds
            let acc = 0
            for x in $xs {
                $body
                acc += 1
            }
            acc
        })
    }
    let t = type_of(sample)
    if end == "collect" {
        return quote({
            $binds
            let acc: [$t] = []
            for x in $xs {
                $body
                push(acc, v)
            }
            acc
        })
    }
    let zero = quote(0)
    if t == "f64" || t == "f32" {
        zero = quote(0.0)
    }
    return quote({
        $binds
        let acc: $t = $zero
        for x in $xs {
            $body
            acc += v
        }
        acc
    })
}

// Stops the expansion, saying why; the compiler adds where.
fn not_a_stage(s: expr) {
    print("fuse!: `" + stringify(s) + "` is not a stage: write map(f) or filter(f), and end with sum(), count() or collect()")
    trap()
}

// The code of one stage, after the stages before it in `body`. `v` is the
// value so far, the same `v` in every piece of code one expansion builds.
fn fuse_stage(kind: str, call: expr, body: stmts) -> stmts {
    if kind == "map" {
        return quote {
            $body
            let v = $call
        }
    }
    return quote {
        $body
        if !$call { continue }
    }
}

#![freestanding]
// Memory allocation for freestanding programs (x86_64 and aarch64 Linux): a
// bump allocator over `mmap`, and a growable `Vec(T)` on top of it.
//
//   import alloc
//   let arena = alloc.arena_new(1 << 20)
//   let v = alloc.vec_new(i64, &arena)
//   alloc.push(i64, &v, 42)
//   alloc.arena_free(&arena)
//
// Misuse stops the program with `trap()`, as an array index out of bounds
// does: an index past the end, `pop` on an empty Vec, an alignment that is
// not a power of two, a negative size. Running out of memory does not: it
// is reported, as a null pointer or `false`. Whatever an arena handed out
// must not be used after `arena_free`.

import sys

pub const PROT_READ = 0x1
pub const PROT_WRITE = 0x2
pub const MAP_PRIVATE = 0x02
pub const MAP_ANONYMOUS = 0x20

const I64_MAX = 9223372036854775807

// ---- Arena ----

// Hands out memory from one block; everything is freed at once by
// `arena_free`. Its fields are private, so that only this module changes
// them; `arena_used` and `arena_cap` read them.
pub struct Arena {
    base: *u8
    used: i64
    cap: i64
}

// A new arena of `cap` bytes, or one with no room at all (`arena_cap` is 0)
// if `cap` is not positive or the kernel said no.
pub fn arena_new(cap: i64) -> Arena {
    let none = Arena { base: 0 as *u8, used: 0, cap: 0 }
    if cap <= 0 {
        return none
    }
    let p = syscall(sys.MMAP, 0, cap, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, 0 - 1, 0)
    // The kernel returns -errno, from -4095 to -1, on failure.
    if p < 0 && p >= -4095 {
        return none
    }
    return Arena { base: p as *u8, used: 0, cap: cap }
}

// Gives the arena's memory back to the kernel. Afterwards the arena has no
// room, and nothing it handed out may be used. Freeing twice does nothing.
pub fn arena_free(a: *Arena) {
    if a.cap > 0 {
        syscall(sys.MUNMAP, a.base, a.cap)
    }
    a.base = 0 as *u8
    a.used = 0
    a.cap = 0
}

// The bytes handed out so far, padding for alignment included.
pub fn arena_used(a: *Arena) -> i64 {
    return a.used
}

// The bytes the arena has in all.
pub fn arena_cap(a: *Arena) -> i64 {
    return a.cap
}

// `size` bytes aligned to `align`, or null when the arena has no room left.
// `size` must not be negative, and `align` must be a power of two.
pub fn alloc(a: *Arena, size: i64, align: i64) -> *u8 {
    if size < 0 || align <= 0 || (align & (align - 1)) != 0 {
        trap()
    }
    // Padding up to the next multiple of `align`. Every step stays within
    // 0..=cap, so nothing overflows.
    let pad = (align - (a.used & (align - 1))) & (align - 1)
    if pad > a.cap - a.used {
        return 0 as *u8
    }
    let start = a.used + pad
    if size > a.cap - start {
        return 0 as *u8
    }
    a.used = start + size
    return a.base + start
}

// Room for `n` values of type `T`, or null when the arena has no room left
// (or `n` of them would not even fit an i64). `n` must not be negative.
pub fn alloc_array(comptime T: type, a: *Arena, n: i64) -> *T {
    if n < 0 {
        trap()
    }
    if size_of(T) > 0 && n > I64_MAX / size_of(T) {
        return 0 as *T
    }
    return alloc(a, n * size_of(T), align_of(T)) as *T
}

// ---- Vec(T) ----

// A growable array in an arena. Its fields are private, so that `len` never
// exceeds what was allocated: `vec_len` and `vec_cap` read them.
//
// A Vec is a struct holding a pointer to its elements, so a copy (`let w = v`)
// shares them with the original; pushing to both makes them overwrite each
// other. Keep one Vec and pass it around by pointer, as these functions take it.
pub struct Vec(T: type) {
    data: *T
    len: i64
    cap: i64
    arena: *Arena
}

pub fn vec_new(comptime T: type, a: *Arena) -> Vec(T) {
    return Vec(T) { data: 0 as *T, len: 0, cap: 0, arena: a }
}

// The number of elements.
pub fn vec_len(comptime T: type, v: *Vec(T)) -> i64 {
    return v.len
}

// The number of elements the Vec has room for before it grows.
pub fn vec_cap(comptime T: type, v: *Vec(T)) -> i64 {
    return v.cap
}

// The elements, for code that needs a pointer (a syscall, C). Not checked:
// only the first `vec_len` are valid, and only until the next `push`.
pub fn vec_data(comptime T: type, v: *Vec(T)) -> *T {
    return v.data
}

// Appends `x`, growing the storage when it is full. Returns false, leaving
// the Vec as it was, if the arena has no room left.
pub fn push(comptime T: type, v: *Vec(T), x: T) -> bool {
    if v.len == v.cap {
        let cap = 4
        if v.cap > 0 {
            if v.cap > I64_MAX / 2 {
                return false
            }
            cap = v.cap * 2
        }
        let p = alloc_array(T, v.arena, cap)
        if p == 0 as *T {
            return false
        }
        let i = 0
        while i < v.len {
            p[i] = v.data[i]
            i = i + 1
        }
        v.data = p
        v.cap = cap
    }
    v.data[v.len] = x
    v.len = v.len + 1
    return true
}

// Element `i`. Traps unless `0 <= i < vec_len`.
pub fn get(comptime T: type, v: *Vec(T), i: i64) -> T {
    check_index(i, v.len)
    return v.data[i]
}

// Replaces element `i`. Traps unless `0 <= i < vec_len`.
pub fn set(comptime T: type, v: *Vec(T), i: i64, x: T) {
    check_index(i, v.len)
    v.data[i] = x
}

// Removes and returns the last element. Traps if the Vec is empty.
pub fn pop(comptime T: type, v: *Vec(T)) -> T {
    if v.len == 0 {
        trap()
    }
    v.len = v.len - 1
    return v.data[v.len]
}

// Removes every element, keeping the storage for new ones.
pub fn clear(comptime T: type, v: *Vec(T)) {
    v.len = 0
}

fn check_index(i: i64, len: i64) {
    if i < 0 || i >= len {
        trap()
    }
}

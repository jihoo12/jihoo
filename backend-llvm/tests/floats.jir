; Float semantics: float to int saturates and NaN becomes 0 (LLVM's fptosi
; would be poison), `rem` is fmod, and f32 arithmetic rounds to f32.
; expect: exit 15
jir 3
profile freestanding

fn @to_i64(f64) -> i64 {
  regs f64 i64
bb0:
  %1 = cast %0
  ret %1
}

fn @div(f64, f64) -> f64 {
  regs f64 f64 f64
bb0:
  %2 = div %0, %1
  ret %2
}

fn @rem(f64, f64) -> f64 {
  regs f64 f64 f64
bb0:
  %2 = rem %0, %1
  ret %2
}

fn @third(f32) -> f32 {
  regs f32 f32 f32
bb0:
  %1 = fconst 3.0
  %2 = div %0, %1
  ret %2
}

fn @bit(i64, bool, i64) -> i64 {
  regs i64 bool i64 i64 i64
bb0:
  %3 = cast %1
  %4 = shl %3, %2
  %0 = or %0, %4
  ret %0
}

fn @_start() -> i64 {
  regs i64 i64 f64 i64 i64 bool f64 f64 i64 i64 bool f64 f64 f64 bool f32 f32 f64 f64 bool
bb0:
  %0 = const 0
  ; 1e300 saturates to i64::MAX
  %2 = fconst 1e300
  %3 = call @to_i64(%2)
  %4 = const 9223372036854775807
  %5 = eq %3, %4
  %1 = const 0
  %0 = call @bit(%0, %5, %1)
  ; 0.0 / 0.0 is NaN, which becomes 0
  %6 = fconst 0.0
  %7 = call @div(%6, %6)
  %8 = call @to_i64(%7)
  %9 = const 0
  %10 = eq %8, %9
  %1 = const 1
  %0 = call @bit(%0, %10, %1)
  ; -7.5 rem 2.0 is -1.5
  %11 = fconst -7.5
  %12 = fconst 2.0
  %13 = call @rem(%11, %12)
  %12 = fconst -1.5
  %14 = eq %13, %12
  %1 = const 2
  %0 = call @bit(%0, %14, %1)
  ; 1 / 3 in f32, widened, is not 1 / 3 in f64
  %15 = fconst 1.0
  %16 = call @third(%15)
  %17 = cast %16
  %18 = fconst 0.3333333432674408
  %19 = eq %17, %18
  %1 = const 3
  %0 = call @bit(%0, %19, %1)
  ret %0
}

; Integer semantics that LLVM leaves undefined or that depend on the type:
; wrapping, MIN / -1 and MIN % -1, shifts modulo the width, signed and
; unsigned operations, and casts. Each check sets one bit of the result.
; The operations are in functions of their own, so they run on values LLVM
; cannot fold.
; expect: exit 255
jir 3
profile freestanding

fn @add8(i8, i8) -> i8 {
  regs i8 i8 i8
bb0:
  %2 = add %0, %1
  ret %2
}

fn @div(i64, i64) -> i64 {
  regs i64 i64 i64
bb0:
  %2 = div %0, %1
  ret %2
}

fn @rem(i64, i64) -> i64 {
  regs i64 i64 i64
bb0:
  %2 = rem %0, %1
  ret %2
}

fn @shl(i64, i64) -> i64 {
  regs i64 i64 i64
bb0:
  %2 = shl %0, %1
  ret %2
}

fn @shr(i64, i64) -> i64 {
  regs i64 i64 i64
bb0:
  %2 = shr %0, %1
  ret %2
}

fn @udiv(u64, u64) -> u64 {
  regs u64 u64 u64
bb0:
  %2 = div %0, %1
  ret %2
}

fn @ugt(u64, u64) -> bool {
  regs u64 u64 bool
bb0:
  %2 = gt %0, %1
  ret %2
}

fn @to_u8(i32) -> u8 {
  regs i32 u8
bb0:
  %1 = cast %0
  ret %1
}

; `score | (b as i64) << k`
fn @bit(i64, bool, i64) -> i64 {
  regs i64 bool i64 i64 i64
bb0:
  %3 = cast %1
  %4 = shl %3, %2
  %0 = or %0, %4
  ret %0
}

fn @_start() -> i64 {
  regs i64 i64 i64 i8 i8 i8 i8 bool i64 i64 i64 bool i64 i64 bool i64 i64 i64 i64 bool i64 i64 i64 i64 bool u64 u64 bool u64 u64 u64 bool i32 u8 u8 bool
bb0:
  %0 = const 0
  ; 127 + 1 wraps to -128 in i8
  %3 = const 127
  %4 = const 1
  %5 = call @add8(%3, %4)
  %6 = const -128
  %7 = eq %5, %6
  %1 = const 0
  %0 = call @bit(%0, %7, %1)
  ; MIN / -1 is MIN
  %8 = const -9223372036854775808
  %9 = const -1
  %10 = call @div(%8, %9)
  %11 = eq %10, %8
  %1 = const 1
  %0 = call @bit(%0, %11, %1)
  ; MIN % -1 is 0
  %12 = call @rem(%8, %9)
  %13 = const 0
  %14 = eq %12, %13
  %1 = const 2
  %0 = call @bit(%0, %14, %1)
  ; 1 << 65 is 1 << 1 for an i64
  %15 = const 1
  %16 = const 65
  %17 = call @shl(%15, %16)
  %18 = const 2
  %19 = eq %17, %18
  %1 = const 3
  %0 = call @bit(%0, %19, %1)
  ; shr of a signed value fills with the sign
  %20 = const -16
  %21 = const 2
  %22 = call @shr(%20, %21)
  %23 = const -4
  %24 = eq %22, %23
  %1 = const 4
  %0 = call @bit(%0, %24, %1)
  ; u64 -1 is the largest u64
  %25 = const -1
  %26 = const 1
  %27 = call @ugt(%25, %26)
  %1 = const 5
  %0 = call @bit(%0, %27, %1)
  ; and divides unsigned
  %28 = const 2
  %29 = call @udiv(%25, %28)
  %30 = const 9223372036854775807
  %31 = eq %29, %30
  %1 = const 6
  %0 = call @bit(%0, %31, %1)
  ; -1 as u8 is 255
  %32 = const -1
  %33 = call @to_u8(%32)
  %34 = const 255
  %35 = eq %33, %34
  %1 = const 7
  %0 = call @bit(%0, %35, %1)
  ret %0
}

; An exported function is also defined as a C symbol, taking and returning a
; struct the C way; the program can still call it as its own.
; expect: exit 42
jir 13
profile freestanding

struct $P { x: i64, y: f64 } size 16 align 8

fn @swap($P) -> $P export @swap_p {
  regs $P i64 f64 $P
bb0:
  %1 = field %0, 0
  %2 = field %0, 1
  %2 = neg %2
  %3 = struct $P(%1, %2)
  ret %3
}

fn @_start() -> i64 {
  regs i64 f64 $P $P i64
bb0:
  %0 = const 42
  %1 = fconst 1.5
  %2 = struct $P(%0, %1)
  %3 = call @swap(%2)
  %4 = field %3, 0
  ret %4
}

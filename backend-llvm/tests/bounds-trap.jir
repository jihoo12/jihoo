; An element index out of bounds traps.
; expect: trap
jir 1
profile freestanding

fn @get([3 x i64], i64) -> i64 {
  regs [3 x i64] i64 i64
bb0:
  %2 = elem %0, %1
  ret %2
}

fn @_start() -> i64 {
  regs i64 [3 x i64] i64 i64
bb0:
  %0 = const 1
  %1 = splat %0
  %2 = const 3
  %3 = call @get(%1, %2)
  ret %3
}

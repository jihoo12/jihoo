// jihoo half of the struct-passing test: calls the C functions of
// `structs.c` with structs by value and exports functions C calls back. Each
// failed check returns its own number.
#![native]

struct I2 { a: i32, b: i32 }
struct D2 { x: f64, y: f64 }
struct F3 { x: f32, y: f32, z: f32 }
struct ID { a: i64, b: f64 }
struct BF { tag: u8, v: f32 }
struct Big { a: i64, b: i64, c: i64 }
struct F4 { v: [f32; 4] }
struct D4 { v: [f64; 4] }
struct Nest { inner: I2, flag: bool }
struct Tiny { s: u16 }
struct P2 { a: i64, b: i64 }

extern fn i2_swap(p: I2) -> I2
extern fn d2_scale(p: D2, k: f64) -> D2
extern fn f3_add(a: F3, b: F3) -> F3
extern fn id_mix(p: ID, n: i32) -> ID
extern fn bf_next(p: BF) -> BF
extern fn big_sum(a: Big, b: Big) -> Big
extern fn f4_rev(p: F4) -> F4
extern fn d4_twice(p: D4) -> D4
extern fn nest_flip(n: Nest) -> Nest
extern fn tiny_inc(t: Tiny) -> Tiny
extern fn spill(a: D2, b: D2, c: D2, d: D2, e: D2, f: f64) -> f64
extern fn spill_f3(a: F3, b: F3, c: F3, d: F3) -> f32
extern fn pair_last(a: I2, b: I2, c: I2, d: I2, e: I2, p: P2, z: i64) -> i64
extern fn spill_int(a: I2, b: ID, c: I2, d: I2, e: I2, f: ID, g: I2) -> i64
extern fn call_back() -> i64

export fn jh_mid(a: D2, b: D2) -> D2 { return D2 { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 } }
export fn jh_big(a: Big, k: i64) -> Big { return Big { a: a.a * k, b: a.b * k, c: a.c * k } }
export fn jh_f3(a: F3) -> F3 { return F3 { x: a.z, y: a.y, z: a.x } }
export fn jh_many(a: I2, b: I2, c: I2, d: I2, e: I2, f: I2, g: I2, h: Big) -> i64 {
    return (a.a + b.b + c.a + d.b + e.a + f.b + g.a + g.b) as i64 + h.a + h.b + h.c
}
export fn jh_odd(t: Tiny) -> bool { return t.s % 2 == 1 }

fn main() -> i64 {
    let p = i2_swap(I2 { a: 1, b: -2 })
    if p.a != -2 || p.b != 1 { return 1 }
    let d = d2_scale(D2 { x: 1.5, y: -2.0 }, 4.0)
    if d.x != 6.0 || d.y != -8.0 { return 2 }
    let f = f3_add(F3 { x: 1, y: 2, z: 3 }, F3 { x: 0.5, y: 0.25, z: 0.125 })
    if f.x != 1.5 || f.y != 2.25 || f.z != 3.125 { return 3 }
    let m = id_mix(ID { a: 7, b: 0.5 }, 3)
    if m.a != 21 || m.b != 3.5 { return 4 }
    let b = bf_next(BF { tag: 41, v: 1.25 })
    if b.tag != 42 || b.v != 2.5 { return 5 }
    let s = big_sum(Big { a: 1, b: 2, c: 3 }, Big { a: 10, b: 20, c: 30 })
    if s.a != 11 || s.b != 22 || s.c != 33 { return 6 }
    let r = f4_rev(F4 { v: [1.0, 2.0, 3.0, 4.0] })
    if r.v[0] != 4.0 || r.v[3] != 1.0 || r.v[1] != 3.0 { return 7 }
    let t = d4_twice(D4 { v: [1.0, 2.0, 3.0, 4.5] })
    if t.v[0] != 2.0 || t.v[3] != 9.0 { return 8 }
    let n = nest_flip(Nest { inner: I2 { a: 5, b: 6 }, flag: false })
    if n.inner.a != 6 || n.inner.b != 5 || !n.flag { return 9 }
    if tiny_inc(Tiny { s: 65535 }).s != 0 { return 10 }
    let q = D2 { x: 1, y: 2 }
    if spill(q, q, q, q, D2 { x: 3, y: 4 }, 0.5) != 1 + 2 + 1 + 2 + 300 + 4000 + 0.5 { return 11 }
    let i = I2 { a: 1, b: 2 }
    let k = ID { a: 10, b: 20.0 }
    if spill_int(i, k, i, i, i, k, I2 { a: 3, b: 4 }) != 1 + 10 + 2 + 1 + 2 + 10 + 20 + 3000 + 400000 { return 12 }
    let g = F3 { x: 1, y: 2, z: 3 }
    if spill_f3(g, g, g, F3 { x: 4, y: 5, z: 6 }) != 1.0 + 2.0 + 30.0 + 400.0 + 6000.0 { return 13 }
    if pair_last(i, i, i, i, I2 { a: 0, b: 7 }, P2 { a: 8, b: 9 }, 5) != 1 + 7 + 80 + 900 + 5000 { return 14 }
    let back = call_back()
    if back != 0 { return 20 + back }
    // Exported functions are still jihoo functions.
    if jh_big(Big { a: 1, b: 1, c: 1 }, 2).c != 2 { return 30 }
    print("ok")
    return 0
}

// Parts taken out of a value that is used again: natively a read of a
// field, an element or a path of them that would be copied moves out
// (`take`) when nothing reads the part before it is written again or the
// value dies, and is copied otherwise. Every case here must print the same
// on the VM.

struct Bag {
    name: str
    xs: [i64]
    n: i64
}

struct Shelf {
    left: Bag
    right: Bag
}

fn grow(xs: [i64]) -> [i64] {
    push(xs, len(xs))
    return xs
}

fn sum(xs: [i64]) -> i64 {
    let s = 0
    for x in xs {
        s = s + x
    }
    return s
}

fn bag(name: str, n: i64) -> Bag {
    let xs: [i64] = []
    for i in 0..n {
        push(xs, i)
    }
    return Bag { name: name, xs: xs, n: n }
}

// The field is replaced by a function of itself: moved out and back.
fn replaced(b: Bag, rounds: i64) -> Bag {
    for i in 0..rounds {
        b.xs = grow(b.xs)
    }
    return b
}

// Replaced on one way only: the other reads the old field, so it is copied.
fn sometimes(b: Bag, keep: bool) -> i64 {
    let ys = grow(b.xs)
    if keep {
        return sum(b.xs) * 1000 + sum(ys)
    }
    b.xs = ys
    return sum(b.xs)
}

// Read again before it is written: copied.
fn read_again(b: Bag) -> i64 {
    let ys = grow(b.xs)
    let before = len(b.xs)
    b.xs = ys
    return before * 100 + len(b.xs)
}

// Another field stays a view while one is taken.
fn two_fields(b: Bag) -> i64 {
    let name = b.name
    b.xs = grow(b.xs)
    return len(name) * 100 + len(b.xs)
}

// A field of a field, and the struct dies with the field empty.
fn nested(s: Shelf) -> i64 {
    s.left.xs = grow(s.left.xs)
    let r = s.right
    r.xs = grow(r.xs)
    return sum(s.left.xs) + sum(r.xs) * 10
}

// The struct returned after the field moved out and back in.
fn swap_names(s: Shelf) -> Shelf {
    let a = s.left.name
    s.left.name = s.right.name
    s.right.name = a
    return s
}

// Elements of a list replaced by a function of themselves.
fn grow_all(rows: [[i64]]) -> [[i64]] {
    for i in 0..len(rows) {
        rows[i] = grow(rows[i])
    }
    return rows
}

// Another index: the element may be the same one, so it is copied.
fn cross(rows: [[i64]], i: i64, j: i64) -> i64 {
    let r = grow(rows[i])
    rows[j] = r
    return len(rows[i]) * 10 + len(rows[j])
}

// The index changes between the read and the write: copied.
fn shifted(rows: [[i64]], i: i64) -> i64 {
    let r = grow(rows[i])
    i = 0
    rows[i] = r
    return len(rows[0]) * 10 + len(rows[len(rows) - 1])
}

// Written inside the part before the part is: copied (an empty list would
// have no element 0 to write).
fn inside(s: Shelf) -> i64 {
    let xs = grow(s.left.xs)
    s.left.xs[0] = 7
    s.left.xs = xs
    return sum(s.left.xs)
}

// A path through elements and fields, in a loop.
fn deep(shelves: [Shelf], rounds: i64) -> [Shelf] {
    for r in 0..rounds {
        for i in 0..len(shelves) {
            shelves[i].right.xs = grow(shelves[i].right.xs)
        }
    }
    return shelves
}

// An array of lists.
fn columns(cols: [[i64]; 3]) -> i64 {
    for i in 0..3 {
        cols[i] = grow(cols[i])
    }
    return len(cols[0]) + len(cols[1]) * 10 + len(cols[2]) * 100
}

fn entry() -> i64 {
    let b = replaced(bag("b", 3), 4)
    out(len(b.xs) * 100 + sum(b.xs))
    out(len(b.name))
    out(sometimes(bag("s", 3), true))
    out(sometimes(bag("s", 3), false))
    out(read_again(bag("r", 5)))
    out(two_fields(bag("two", 2)))
    let shelf = Shelf { left: bag("l", 2), right: bag("r", 3) }
    out(nested(shelf))
    // The caller's value is unchanged.
    out(sum(shelf.left.xs) + len(shelf.right.xs))
    let swapped = swap_names(Shelf { left: bag("left", 1), right: bag("rt", 1) })
    out(len(swapped.left.name) * 10 + len(swapped.right.name))

    // In a loop of the caller's own, with the struct read after it.
    let c = bag("c", 0)
    for i in 0..1000 {
        c.xs = grow(c.xs)
        c.n = c.n + 1
    }
    out(len(c.xs) + c.n)

    let rows: [[i64]] = [[], [1], [1, 2]]
    let g = grow_all(grow_all(rows))
    out(len(g[0]) * 100 + len(g[1]) * 10 + len(g[2]))
    out(len(rows[2]))
    out(cross(rows, 1, 1))
    out(cross(rows, 1, 2))
    out(shifted(rows, 2))
    out(inside(Shelf { left: bag("i", 2), right: bag("j", 0) }))
    let shelves: [Shelf] = [Shelf { left: bag("a", 1), right: bag("b", 2) }, Shelf { left: bag("c", 0), right: bag("d", 0) }]
    let d = deep(shelves, 50)
    out(len(d[0].right.xs) * 1000 + len(d[1].right.xs))
    out(len(shelves[0].right.xs))
    let empty: [i64] = []
    out(columns([empty, [1], [1, 2]]))
    return 0
}

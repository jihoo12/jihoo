// Calls in tail position run in constant stack in every profile: a
// function's calls of itself are jumps, and calls of others tail calls.
// Natively the lists they pass are handed over to the callee, or moved into
// the parameters, and the rest is freed before each jump or tail call.

// The sum of `xs` from `i` on, with the list passed along.
fn sum_from(xs: [i64], i: i64, acc: i64) -> i64 {
    if i == len(xs) {
        return acc
    }
    return sum_from(xs, i + 1, acc + xs[i])
}

// `xs` with `n`, `n - 1`, ..., 1 pushed: the list is changed and passed on.
fn countdown(xs: [i64], n: i64) -> [i64] {
    if n == 0 {
        return xs
    }
    push(xs, n)
    return countdown(xs, n - 1)
}

// A string built up, and a local list that each round makes and drops.
fn spell(s: str, n: i64) -> str {
    let scratch: [str] = [s, "x"]
    if n == 0 {
        return scratch[0]
    }
    return spell(s + to_str(n % 10), n - 1)
}

// The parameters swapped in the call, and a tail call from inside a loop.
fn gcd(a: i64, b: i64) -> i64 {
    for x in [b] {
        if x == 0 {
            return a
        }
        return gcd(b, a % b)
    }
    return -1
}

// In a `match` arm, on lists of lists.
fn flatten(rest: [[i64]], out: [i64]) -> [i64] {
    match len(rest) {
        0 => return out
        _ => {
            for x in rest[0] {
                push(out, x)
            }
            return flatten(rest[1:], out)
        }
    }
}

// A generic instance calls itself.
fn last(comptime T: type, xs: [T], i: i64) -> T {
    if i == len(xs) - 1 {
        return xs[i]
    }
    return last(T, xs, i + 1)
}

// A state machine over a list: states with different parameters pass the
// list, a struct holding a list and a string to each other.
struct Seen {
    odd: [i64]
    count: i64
}

fn scan(xs: [i64], i: i64, seen: Seen, tag: str) -> Seen {
    if i == len(xs) {
        seen.count = seen.count + len(tag)
        return seen
    }
    if xs[i] % 2 == 1 {
        return odd(seen, xs, i, tag)
    }
    return even(xs, i)(seen, tag)
}

fn odd(seen: Seen, xs: [i64], i: i64, tag: str) -> Seen {
    if len(seen.odd) < 4 {
        push(seen.odd, xs[i])
    }
    return scan(xs, i + 1, seen, tag)
}

// Gives the next state as a function value: calling it is not a tail call
// of a function of the program, so it nests (once per even element here).
fn even(xs: [i64], i: i64) -> fn(Seen, str) -> Seen {
    let rest = xs[i + 1:]
    return fn(s: Seen, tag: str) -> Seen {
        s.count = s.count + 1
        return scan(rest, 0, s, tag + "e")
    }
}

// A parameter never read, handed over all the same.
fn skip(unused: [str], n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    return skip_more(n - 1, unused)
}

fn skip_more(n: i64, more: [str]) -> i64 {
    return skip([], n) + len(more)
}

// Handed a list it never reads, which it frees on entry.
fn ignore(xs: [str], box: ref [i64], n: i64) -> i64 {
    return n
}

fn ignore_all(n: i64) -> i64 {
    let mine: [str] = ["x", "y"]
    return ignore(mine, ref [1, 2, 3], n)
}

fn entry() -> i64 {
    let xs: [i64] = []
    for i in 0..100000 {
        push(xs, i % 7)
    }
    out(sum_from(xs, 0, 0))                   // 299995
    let c = countdown([], 200000)
    out(len(c) + c[0] - c[len(c) - 1])        // 399999
    out(len(spell("", 50000)))                // 50000
    out(gcd(1071, 462))                       // 21
    let nested: [[i64]] = [[1, 2], [], [3], [4, 5, 6]]
    out(len(flatten(nested, [])))             // 6
    let words: [str] = ["a", "b", "last"]
    out(len(last(words, 0)))                  // 4
    let odds: [i64] = []
    for i in 0..300000 {
        push(odds, 2 * i + 1)
    }
    let s = scan(odds, 0, Seen { odd: [], count: 0 }, "t")
    out(len(s.odd) * 1000000 + s.count)       // 4000001
    let mixed: [i64] = [1, 2, 3, 5, 6, 7, 9]
    let m = scan(mixed, 0, Seen { odd: [], count: 0 }, "t")
    out(m.odd[3] * 100 + m.count)
    out(skip(words, 10))
    out(ignore_all(5))
    return last(xs, 0)
}

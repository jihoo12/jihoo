// Pipelines fused by `lists.fuse!` must give what the same pipelines give
// with `lists.map`, `lists.filter` and `lists.fold`, and `meta.node` must see
// the shape of code as the parser does.
import lists
import meta

fn total(xs: [i64]) -> i64 {
    return lists.fold(i64, i64, xs, 0, fn(a: i64, x: i64) -> i64 { return a + x })
}

// A number for each shape of code: what `meta.node` sees.
macro shape(e: expr) -> expr {
    match meta.node(e) {
        Call(f, args) => return quote($(100 + len(args)))
        Name(n) => return quote($(200 + len(n)))
        Int(n) => return quote($(300000 + n))
        Str(s) => return quote($(400 + len(s)))
        Binary(op, l, r) => return quote($(500 + len(op)) * 1000 + $l - ($r))
        Func(params, f) => return quote($(600 + len(params)))
        Other => return quote(700)
    }
}

fn add(a: i64, b: i64) -> i64 {
    return a + b
}

fn entry() -> i64 {
    let xs: [i64] = []
    for i in 0..50 {
        push(xs, i * 7 % 23 - 5)
    }
    let k = 3

    let a = lists.fuse!(xs, map(fn(x: i64) -> i64 { return x * k }))
    out(a - total(lists.map(i64, i64, xs, fn(x: i64) -> i64 { return x * k })))

    let b = lists.fuse!(xs, filter(fn(x: i64) -> bool { return x > 0 }), map(fn(x: i64) -> i64 { return x + 1 }), sum())
    out(b - total(lists.map(i64, i64, lists.filter(i64, xs, fn(x: i64) -> bool { return x > 0 }), fn(x: i64) -> i64 { return x + 1 })))

    let c = lists.fuse!(xs)
    out(c - total(xs))

    // Captured values, and a filter that keeps nothing.
    let limit = 1000
    let d = lists.fuse!(xs, filter(fn(x: i64) -> bool { return x > limit }))
    out(d)
    // Other number types: the sum starts at the zero of the last stage's type.
    let small: [u8] = [200, 100, 7]
    let bytes = lists.fuse!(small, map(fn(b: u8) -> u8 { return b / 2 }))
    out(bytes as i64)                // 100 + 50 + 3, as a u8: 153
    let halves = lists.fuse!(xs, map(fn(x: i64) -> f64 { return x as f64 / 2.0 }), filter(fn(h: f64) -> bool { return h > 0.0 }))
    out((halves * 2.0) as i64 - total(lists.filter(i64, xs, fn(x: i64) -> bool { return x > 0 })))
    let wide = lists.fuse!(small, map(fn(b: u8) -> i64 { return b as i64 * 1000 }))
    out(wide)                        // 307000

    // `count()` and `collect()` end a pipeline too.
    let pos = fn(x: i64) -> bool { return x > 0 }
    out(lists.fuse!(xs, filter(pos), count()) - len(lists.filter(i64, xs, pos)))
    let kept = lists.fuse!(xs, filter(pos), map(fn(x: i64) -> i64 { return x * k }), collect())
    let same = lists.map(i64, i64, lists.filter(i64, xs, pos), fn(x: i64) -> i64 { return x * k })
    out(len(kept))
    if kept == same { out(1) } else { out(0) }
    let none = lists.fuse!(xs, filter(fn(x: i64) -> bool { return x > limit }), collect())
    out(len(none))

    // A fused pipeline is an expression like any other.
    out(lists.fuse!(xs, map(fn(x: i64) -> i64 { return x % 4 })) * 2 - lists.fuse!(xs, map(fn(x: i64) -> i64 { return 2 * (x % 4) })))

    out(shape!(add(1, 2)))
    out(shape!(xs))
    out(shape!(1_000))
    out(shape!("a\"b"))
    out(shape!(10 - 2 - 3))         // `-` applies last: (10 - 2) and 3
    out(shape!(1 + 2 * 3))
    out(shape!(fn(p: i64, q) -> i64 { return p }))
    out(shape!(-k))
    out(shape!(((k))))
    return a + b
}

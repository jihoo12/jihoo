// Arrays are values: copies are independent, and nested element updates rebuild
// the outer aggregate.

struct Item {
    key: i64
    tags: [u8; 3]
}

fn sieve() -> i64 {
    let composite = [false; 200]
    let count = 0
    let i = 2
    while i < len(composite) {
        if !composite[i] {
            count = count + 1
            let j = i * i
            while j < len(composite) {
                composite[j] = true
                j = j + i
            }
        }
        i = i + 1
    }
    return count // 46 primes below 200
}

fn sort(xs: [Item; 5]) -> [Item; 5] {
    let i = 1
    while i < len(xs) {
        let cur = xs[i]
        let j = i - 1
        while j >= 0 && xs[j].key > cur.key {
            xs[j + 1] = xs[j]
            j = j - 1
        }
        xs[j + 1] = cur
        i = i + 1
    }
    return xs
}

fn entry() -> i64 {
    let items = [
        Item { key: 4, tags: [1, 2, 3] },
        Item { key: 1, tags: [4, 5, 6] },
        Item { key: 3, tags: [7, 8, 9] },
        Item { key: 5, tags: [0; 3] },
        Item { key: 2, tags: [9; 3] },
    ]
    let sorted = sort(items)
    sorted[0].tags[2] = 100
    let order = 0
    let k = 0
    while k < len(sorted) {
        order = order * 10 + sorted[k].key
        k = k + 1
    }
    // 12345 % 97 = 26; sorted[0] is the old items[1]
    return order % 97 + (sorted[0].tags[2] as i64) + (items[1].tags[2] as i64) + sieve()
    // 26 + 100 + 6 + 46 = 178
}

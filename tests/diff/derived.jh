// `meta.derive!` writes impls of `Hash` and `Ord` part by part, the same in
// every profile (`meta` only runs while compiling).
import meta

struct Version {
    major: i64
    minor: u8
}

enum Shape {
    Circle(i64)
    Rect(i64, i64)
    Empty
}

meta.derive!(Hash, Ord, Version)
meta.derive!(Hash, Ord, Shape)

fn same(comptime T: Hash, a: T, b: T) -> i64 {
    if hash_of(a) == hash_of(b) {
        return 1
    }
    return 0
}

fn entry() -> i64 {
    let a = Version { major: 1, minor: 9 }
    let b = Version { major: 2, minor: 0 }
    out((a < b) as i64)                                       // 1: majors first
    out(a.compare(Version { major: 1, minor: 9 }))            // 0
    out(same(a, Version { major: 1, minor: 9 }))              // 1
    out(same(a, b))                                           // 0
    // Variants in the order they are declared, then their values.
    out((Shape.Circle(100) < Shape.Rect(0, 0)) as i64)        // 1
    out(Shape.Rect(1, 2).compare(Shape.Rect(1, 1)))           // 1
    out((Shape.Empty > Shape.Rect(9, 9)) as i64)              // 1
    out(same(Shape.Rect(1, 2), Shape.Rect(1, 2)))             // 1
    out(same(Shape.Circle(1), Shape.Rect(1, 0)))              // 0
    out(hash_of(Shape.Empty) as i64)                          // the same everywhere
    return Shape.Empty.compare(Shape.Empty)                   // 0
}

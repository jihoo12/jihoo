// Generic functions are instantiated per comptime argument; every instance must
// behave the same on both backends.

struct Pair {
    a: i64
    b: u8
}

fn max(comptime T: type, x: T, y: T) -> T {
    if x > y {
        return x
    }
    return y
}

fn reverse(comptime T: type, comptime N: i64, xs: [T; N]) -> [T; N] {
    let i = 0
    while i < N / 2 {
        let t = xs[i]
        xs[i] = xs[N - 1 - i]
        xs[N - 1 - i] = t
        i = i + 1
    }
    return xs
}

fn pow(comptime T: type, x: T, n: i64) -> T {
    if n == 0 {
        return 1
    }
    return x * pow(T, x, n - 1)
}

fn entry() -> i64 {
    let small: u8 = 250
    let r = reverse(Pair, 3, [Pair { a: 1, b: 10 }, Pair { a: 2, b: 20 }, Pair { a: 3, b: 30 }])
    let bytes = reverse(u8, 4, [1, 2, 3, 4])
    let total = max(i64, -5, 7)                 // 7
    total = total + max(u8, small, 3) as i64    // 250
    total = total + r[0].a * 100 + r[2].b as i64 // 300 + 10
    total = total + (bytes[0] as i64) * 1000    // 4000
    total = total + pow(u8, 3, 5) as i64        // 243
    return total                                // 4810
}

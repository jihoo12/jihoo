// Calls in tail position do not nest: deep recursion runs in constant stack
// on the VM, natively and freestanding, at every -O. A function's calls of
// itself are jumps, and calls of others tail calls.

fn count(n: i64, acc: i64) -> i64 {
    if n == 0 {
        return acc
    }
    return count(n - 1, acc + 1)
}

// Collatz steps, with the tail call in either branch.
fn steps(n: u64, k: i64) -> i64 {
    if n == 1 {
        return k
    }
    if n % 2 == 0 {
        return steps(n / 2, k + 1)
    }
    return steps(3 * n + 1, k + 1)
}

struct Acc {
    sum: i64
    last: i64
}

// A struct carried along, and the parameters swapped every round.
fn walk(a: i64, b: i64, acc: Acc, n: i64) -> Acc {
    if n == 0 {
        return acc
    }
    return walk(b, a + b, Acc { sum: acc.sum + a, last: b }, n - 1)
}

// Mutual recursion through functions of different signatures.
fn is_even(n: i64) -> bool {
    if n == 0 {
        return true
    }
    return is_odd(n - 1, 1)
}

fn is_odd(n: i64, unused: u8) -> bool {
    if n == 0 {
        return false
    }
    return is_even(n - 1)
}

// A state machine whose states pass a struct and an array by value, and
// return a struct, to each other.
struct Tally {
    a: i64
    b: i64
    c: i64
}

fn state_a(t: Tally, seen: [i64; 3], n: i64) -> Tally {
    if n == 0 {
        return Tally { a: t.a + seen[0], b: t.b + seen[1], c: t.c + seen[2] }
    }
    seen[0] = seen[0] + 1
    return state_b(n - 1, Tally { a: t.a + 1, b: t.b, c: t.c }, seen)
}

fn state_b(n: i64, t: Tally, seen: [i64; 3]) -> Tally {
    seen[1] = seen[1] + 1
    if n % 3 == 0 {
        return state_c(seen, t, n)
    }
    return state_a(Tally { a: t.a, b: t.b + 2, c: t.c }, seen, n)
}

fn state_c(seen: [i64; 3], t: Tally, n: i64) -> Tally {
    seen[2] = seen[2] + 1
    return state_a(Tally { a: t.a, b: t.b, c: t.c + 3 }, seen, n)
}

// Not a tail call: the result is used after the call returns.
fn depth(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    return 1 + depth(n - 1)
}

fn entry() -> i64 {
    out(count(3000000, 0))                    // 3000000
    out(steps(27, 0))                         // 111
    let a = walk(0, 1, Acc { sum: 0, last: 0 }, 40)
    out(a.sum)                                // 165580140
    out(a.last)                               // 102334155
    out(is_even(1000000) as i64)              // 1
    out(is_odd(777777, 0) as i64)             // 1
    let t = state_a(Tally { a: 0, b: 0, c: 0 }, [0, 0, 0], 1000000)
    out(t.a)
    out(t.b)
    out(t.c)
    return depth(1000)                        // 1000
}

// Tuples: building, reading and changing parts, patterns, `let (a, b) = ...`,
// equality, and tuples inside structs, arrays, enums and generics.

struct Span {
    at: (i64, i64)
    len: u8
}

enum Shape {
    Dot((i64, i64))
    Line((i64, i64), (i64, i64))
}

struct Pair(T: type) {
    a: T
    b: T
}

// Parts and `let` patterns in macro templates, which keep their own names.
macro second(e: expr) -> expr {
    return quote({ let t = $e; t.1 })
}

macro unpacked(e: expr) -> stmts {
    return quote {
        let (a, b) = $e
        out(b * 10 + a)
    }
}

fn divmod(a: i64, b: i64) -> (i64, i64) {
    return (a / b, a % b)
}

fn swap(p: (i64, bool)) -> (bool, i64) {
    return (p.1, p.0)
}

fn longest(s: Shape) -> i64 {
    match s {
        Dot(_) => return 0
        Line((x0, y0), (x1, y1)) => return (x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0)
    }
}

fn pick(comptime T: type, k: bool, a: T, b: T) -> T {
    if k {
        return a
    }
    return b
}

fn entry() -> i64 {
    let (q, r) = divmod(17, 5)
    out(q)                                  // 3
    out(r)                                  // 2
    let t = divmod(-9, 4)
    out(t.0 * 10 + t.1)                     // -21
    let s = swap((3, true))
    if s.0 {
        out(s.1)                            // 3
    }

    // Nested parts, changed in place; copies stay independent.
    let n: ((i64, i64), u8) = ((1, 2), 7)
    n.0.1 = 40
    n.1 += 1
    out(n.0.1 + n.1 as i64)                 // 48
    let m = n
    m.0.0 = 100
    out(n.0.0)                              // 1
    out(m.0.0)                              // 100
    if m != n && (m.0.1, m.1) == (n.0.1, n.1) {
        out(1)                              // 1
    }

    // Patterns: literals, names, `_`, nesting and `|`.
    let total = 0
    for i in 0..6 {
        match (i % 3, i < 3) {
            (0, true) => total += 1
            (0, false) | (1, false) => total += 10
            (k, true) => total += 100 * k
            (_, _) => total += 1000
        }
    }
    out(total)                              // 1321

    // In structs, arrays and enums.
    let sp = Span { at: (4, 5), len: 2 }
    sp.at.1 = sp.at.0 + sp.at.1
    out(sp.at.1 * sp.len as i64)            // 18
    let grid: [(i64, i64); 3] = [(1, 2), (3, 4), (5, 6)]
    grid[1].0 = 30
    let sum = 0
    for i in 0..3 {
        let (a, b) = grid[i]
        sum += a * b
    }
    out(sum)                                // 152
    out(longest(Shape.Line((1, 1), (4, 5))))    // 25
    out(longest(Shape.Dot((7, 7))))         // 0

    // With generics.
    let p = Pair((i64, bool)) { a: (1, true), b: (2, false) }
    out(p.b.0)                              // 2
    let w = pick((u8, i64), false, (1, 2), (3, 4))
    out(w.0 as i64 + w.1)                   // 7

    // In macros.
    let a = 7
    out(second!((a, second!((1, 2)))))      // 2
    unpacked!(divmod(14, 3))                // 24
    out(a)                                  // 7

    // `(e)` is still a parenthesized expression.
    out((1 + 2) * 3)                        // 9
    return 0
}
